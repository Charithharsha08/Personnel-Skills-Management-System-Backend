SELECT
    p.id AS personnel_id,
    p.name AS personnel_name,
    s.name AS skill_name,
    ps.proficiency_level
FROM personnel p
JOIN personnel_skills ps ON p.id = ps.personnel_id
JOIN project_required_skills prs ON ps.skill_id = prs.skill_id
WHERE prs.project_id = ?
  AND ps.proficiency_level >= prs.minimum_proficiency
ORDER BY p.id;

